<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="ir_cron_slide_channel_archive" model="ir.cron" forcecreate="True">
        <field name="name">eLearning: Check for Courses to Archive</field>
        <field name="model_id" ref="website_slides.model_slide_channel" />
        <field name="state">code</field>
        <field name="code">model.action_archive_courses()</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">3</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field eval="False" name="doall" />
    </record>

</odoo>
