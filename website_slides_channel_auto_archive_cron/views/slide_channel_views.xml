<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_slide_channel_form_inherit" model="ir.ui.view">
        <field
            name="name"
        >slide.channel.view.form.inherit.channel.autoarchive.cron</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form" />
        <field name="arch" type="xml">
            <field name="enroll_msg" position="after">
                <field name="auto_archive_date" />
            </field>
        </field>
    </record>

    <record id="view_slide_channel_tree_inherit" model="ir.ui.view">
        <field
            name="name"
        >slide.channel.view.tree.inherit.channel.autoarchive.cron</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.slide_channel_view_tree" />
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="auto_archive_date" optional="show" />
            </field>
        </field>
    </record>
</odoo>
