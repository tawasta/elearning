<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="view_slide_channel_form" model="ir.ui.view">
        <field name="name">slide.channel.view.form.inherit.batch</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form" />
        <field name="arch" type="xml">
            <field name="website_id" position="after">
                <field name="retry_delay_hours" />
            </field>
        </field>
    </record>

    <record id="slide_slide_partner_view_form" model="ir.ui.view">
        <field name="name">slide.slide.partner.view.form.inherit</field>
        <field name="model">slide.slide.partner</field>
        <field name="inherit_id" ref="website_slides_survey.slide_slide_partner_view_form"/>
        <field name="arch" type="xml">
            <field name="survey_scoring_success" position="after">
                <field name="last_failed_attempt" />
                <field name="next_retry_possible_at" />
            </field>
        </field>
    </record>

</data></odoo>
